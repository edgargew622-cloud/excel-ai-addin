# C1 closed local test server; never use real provider/billing credentials here.
COMMERCIAL_ENABLED=0
COMMERCIAL_AUTH_MODE=test
COMMERCIAL_FAKE_PROVIDER=0
COMMERCIAL_BIND=127.0.0.1
COMMERCIAL_PORT=3300
COMMERCIAL_DATABASE_URL=postgresql://amai_c1:c1-local-test-only@127.0.0.1:55432/amai_c1
# Generate 32 random bytes as 64 hexadecimal characters. Do not commit the real local value.
COMMERCIAL_DEV_MASTER_KEY=replace-with-64-random-hex-characters
# Set to 1 only when explicitly creating an isolated synthetic fixture.
COMMERCIAL_DEV_SEED=0
# C2 closed local pilot. Web app registration; no real values belong in Git.
COMMERCIAL_C2_ENABLED=0
COMMERCIAL_PANEL_ORIGIN=https://localhost:3100
COMMERCIAL_ENTRA_TENANT=
COMMERCIAL_ENTRA_CLIENT_ID=
COMMERCIAL_ENTRA_CLIENT_SECRET=
# Explicit operator mapping of an existing synthetic fixture user to its Entra Object ID.
COMMERCIAL_PILOT_PROVISION=0
COMMERCIAL_PILOT_USER_ID=
COMMERCIAL_PILOT_OBJECT_ID=
