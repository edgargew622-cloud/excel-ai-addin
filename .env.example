# Необязательно: ключи удобнее ввести в панели кнопкой «Ключи» — там они
# шифруются средствами Windows. Этот файл нужен для разработки и настроек.
# Скопируйте в server/.env и заполните те ключи, которые у вас есть.
# Провайдер без ключа просто не появится в списке в панели.
# Если ключ задан и здесь, и в панели, используется ключ из панели.

DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# OpenRouter: в панели только модели, отобранные в providers.ts.
OPENROUTER_API_KEY=

# Рабочий сервер: собранная панель и /api на одном HTTPS-порту.
PORT=3000
