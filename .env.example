# Скопируйте в server/.env и заполните те ключи, которые у вас есть.
# Провайдер без ключа просто не появится в списке в панели.

DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# OpenRouter пока отключён в реестре провайдеров (providers.ts).
OPENROUTER_API_KEY=

# Порт рабочего сервера. Он раздаёт и собранную панель, и /api — один процесс,
# один сертификат, один порт. Адрес должен совпадать с manifest.xml.
# Разработка живёт на 3100 (vite) и берёт /api с этого порта.
PORT=3000
