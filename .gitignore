# Зависимости
node_modules/

# Сборки
dist/
server/dist/

# Секреты: ключи провайдеров. .env.example остаётся в репозитории.
.env
server/.env
server/keys.dpapi
server/keys.dpapi.tmp
server/panel-token

# Локальный каталог надёжных надстроек — копия manifest.xml, создаётся скриптом
catalog/

# Журналы и диагностика
logs/
*.log
*.pem
*.key
*.crt
*.pfx
*.cer
*.tsbuildinfo
releases/

# Временные файлы открытых книг Excel
~$*

# Резервные копии книг: данные пользователя, не исходный код
backups/

# Книги для живых проверок: создаются скриптами scripts/create-*.py
/*-smoke.xlsx
/*-smoke.csv
/pivot-s2-run.xlsx
/stage*-smoke.xlsx

# Готовый комплект для Windows: собирается scripts/bundle.mjs
bundle/
